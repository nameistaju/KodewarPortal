NODE_ENV=development
PORT=5000
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_at_least_32_characters
JWT_REFRESH_EXPIRES_IN=7d

ORGANIZATION_TIMEZONE=Asia/Kolkata

CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGINS=https://sharpkode.com,https://www.sharpkode.com

UPLOAD_ROOT=/var/www/sharpkode/uploads

OFFICE_LATITUDE=17.72861938927439
OFFICE_LONGITUDE=83.3146940456679
OFFICE_ALLOWED_RADIUS_METERS=100

BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_NAME=SharpKode Admin
BOOTSTRAP_ADMIN_EMAIL=admin@sharpkode.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisAdminPasswordImmediately
BOOTSTRAP_ADMIN_ROLE=admin

BOOTSTRAP_EMPLOYEE_ENABLED=true
BOOTSTRAP_EMPLOYEE_NAME=Demo Employee
BOOTSTRAP_EMPLOYEE_EMAIL=employee@sharpkode.com
BOOTSTRAP_EMPLOYEE_PASSWORD=ChangeThisEmployeePasswordImmediately
BOOTSTRAP_EMPLOYEE_ROLE=employee
